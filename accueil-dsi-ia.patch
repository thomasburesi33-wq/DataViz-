+
+def barh_pair(table: pd.DataFrame, title: str, labels: tuple[str, str],
+              columns: tuple[str, str] = ("share_fr", "share_eu"),
+              xlabel: str = "Part des répondants") -> Figure:
+    """Barres horizontales groupées : deux séries par modalité (colonne option),
+    par exemple France (SERIES_1) face à l'Europe (SERIES_2)."""
+    data = table.iloc[::-1].reset_index(drop=True)
+    y = range(len(data))
+    h = 0.38
+    fig, ax = plt.subplots(figsize=(8, 0.6 * max(len(data), 3) + 1.4))
+    for offset, col, color, label in ((h / 2, columns[0], SERIES_1, labels[0]),
+                                      (-h / 2, columns[1], SERIES_2, labels[1])):
+        bars = ax.barh([i + offset for i in y], data[col], height=h, color=color, label=label)
+        ax.bar_label(bars, labels=[f"{s:.0%}" for s in data[col]], padding=3,
+                     color=TEXT_PRIMARY, fontsize=8)
+    ax.set_yticks(list(y), data["option"])
+    ax.xaxis.set_major_formatter(PercentFormatter(1.0, decimals=0))
+    top = float(data[list(columns)].max().max()) if len(data) else 1
+    ax.set_xlim(0, max(top * 1.18, 0.05))
+    ax.set_xlabel(xlabel, color=TEXT_SECONDARY)
+    ax.set_title(title, loc="left", color=TEXT_PRIMARY, fontsize=12, fontweight="bold",
+                 pad=26)
+    ax.legend(frameon=False, loc="lower left", bbox_to_anchor=(0, 1.0), ncol=2, fontsize=9)
+    _style(ax)
+    fig.tight_layout()
+    return fig
