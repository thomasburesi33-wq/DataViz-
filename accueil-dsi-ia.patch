@@ -0,0 +1,118 @@
+"""Tableau de bord principal : la France face à ses voisins européens sur l'usage de l'IA.
+
+Commanditaire : la DSI d'un grand groupe industriel français (voir CADRAGE.md).
+Fonctions pures, sans Streamlit : app.py ne fait qu'afficher les tables renvoyées ici.
+"""
+from __future__ import annotations
+
+import pandas as pd
+
+from analysis import config, indicators
+
+FRANCE = "France"
+EUROPE = "Europe (comparaison)"
+ZONE = "Zone"
+
+# Libellés exacts des réponses dans l'enquête 2026.
+NO_AI = "I don’t use AI tools"  # apostrophe typographique ’ (U+2019)
+ENVIRONMENT = "Environmental concerns"
+NO_RESERVE = "I do not avoid using AI at work or school"
+TRUST_VERIFY = "I trust it when I can easily verify the output"
+
+# Traduction des réponses à AIAvoid pour les figures.
+AVOID_LABELS = {
+    NO_RESERVE: "Aucune réserve",
+    "Concern over losing job skills or training an AI to replace you":
+        "Peur de perdre ses compétences ou d'être remplacé",
+    "Moral or ethical concerns": "Raisons morales ou éthiques",
+    ENVIRONMENT: "Préoccupations environnementales",
+    "Issues with privacy or security": "Confidentialité ou sécurité",
+    "Other, please specify:": "Autre",
+}
+
+# Les quatre indicateurs du bandeau : (clé, libellé, colonne, réponse comptée, base).
+KPIS = [
+    ("no_ai", "N'utilisent pas d'IA au travail", "AISelect", NO_AI,
+     "ayant répondu à la question sur l'usage de l'IA"),
+    ("environment", "Citent l'environnement comme frein", "AIAvoid", ENVIRONMENT,
+     "ayant répondu à la question sur les freins à l'IA"),
+    ("no_reserve", "Déclarent n'avoir aucune réserve", "AIAvoid", NO_RESERVE,
+     "ayant répondu à la question sur les freins à l'IA"),
+    ("trust_verify", "Font confiance si le résultat est vérifiable", "AITrust", TRUST_VERIFY,
+     "utilisateurs d'IA ayant répondu à la question sur la confiance"),
+]
+
+
+def add_zone(df: pd.DataFrame, europe: list[str] | None = None) -> pd.DataFrame:
+    """Renvoie les répondants de France et des pays de comparaison, avec une colonne Zone
+    valant « France » ou « Europe (comparaison) ». Les autres pays sont écartés."""
+    europe = config.EUROPE_COMPARISON if europe is None else europe
+    zone = pd.Series(pd.NA, index=df.index, dtype="object")
+    zone[df["Country"].isin(europe)] = EUROPE
+    zone[df["Country"] == FRANCE] = FRANCE
+    return df.assign(**{ZONE: zone}).dropna(subset=[ZONE])
+
+
+def share_answer(df: pd.DataFrame, column: str, answer: str) -> dict[str, float | int | None]:
+    """Part des répondants ayant coché `answer` à la question `column` (choix multiples
+    acceptés). La base est le nombre de répondants à la question. Renvoie share, n, base."""
+    table = indicators.share_multi(df, column)
+    base = int(df[column].notna().sum())
+    row = table[table["option"] == answer]
+    n = int(row["n"].iloc[0]) if not row.empty else 0
+    return {"share": n / base if base else None, "n": n, "base": base}
+
+
+def zone_kpis(df: pd.DataFrame) -> pd.DataFrame:
+    """Les quatre indicateurs du bandeau, France et Europe côte à côte.
+
+    `df` doit contenir la colonne Zone (voir add_zone). Une ligne par indicateur avec les
+    colonnes key, label, column, extra, share_fr, base_fr, share_eu, base_eu, gap_pts.
+    """
+    rows = []
+    for key, label, column, answer, extra in KPIS:
+        fr = share_answer(df[df[ZONE] == FRANCE], column, answer)
+        eu = share_answer(df[df[ZONE] == EUROPE], column, answer)
+        gap = (None if fr["share"] is None or eu["share"] is None
+               else 100 * (fr["share"] - eu["share"]))
+        rows.append({"key": key, "label": label, "column": column, "extra": extra,
+                     "share_fr": fr["share"], "base_fr": fr["base"],
+                     "share_eu": eu["share"], "base_eu": eu["base"], "gap_pts": gap})
+    return pd.DataFrame(rows)
+
+
+def no_ai_by_country(df: pd.DataFrame) -> pd.DataFrame:
+    """Part de répondants n'utilisant pas l'IA au travail, par pays.
+
+    Une ligne par pays (libellé français) avec option, n, base, share, triée par part
+    décroissante : même format que indicators.share_single, lisible par charts.barh_shares.
+    """
+    rows = []
+    for country, group in df.groupby("Country"):
+        s = share_answer(group, "AISelect", NO_AI)
+        if s["base"]:
+            rows.append({"option": config.COUNTRY_LABELS.get(country, country),
+                         "n": s["n"], "base": s["base"], "share": s["share"]})
+    if not rows:
+        return pd.DataFrame(columns=["option", "n", "base", "share"])
+    return pd.DataFrame(rows).sort_values("share", ascending=False, ignore_index=True)
+
+
+def barriers_by_zone(df: pd.DataFrame) -> pd.DataFrame:
+    """Freins à l'usage de l'IA (AIAvoid), France face à l'Europe.
+
+    Une ligne par frein avec option (libellé français), share_fr, share_eu, n_fr, n_eu,
+    base_fr, base_eu ; triée par part en France décroissante.
+    """
+    tables = {}
+    for zone, suffix in ((FRANCE, "fr"), (EUROPE, "eu")):
+        t = indicators.share_multi(df[df[ZONE] == zone], "AIAvoid")
+        tables[suffix] = t.rename(columns={"n": f"n_{suffix}", "base": f"base_{suffix}",
+                                           "share": f"share_{suffix}"})
+    merged = tables["fr"].merge(tables["eu"], on="option", how="outer")
+    merged["option"] = merged["option"].map(AVOID_LABELS).fillna(merged["option"])
+    for col in ("n_fr", "n_eu", "share_fr", "share_eu"):
+        merged[col] = merged[col].fillna(0)
+    for col in ("base_fr", "base_eu"):  # la base est la même pour toutes les modalités
+        merged[col] = merged[col].fillna(merged[col].max())
+    return merged.sort_values("share_fr", ascending=False, ignore_index=True)
