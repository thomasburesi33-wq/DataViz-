+"""Tests du tableau de bord principal (analysis/dashboard.py), sur des données inventées."""
+import pandas as pd
+import pytest
+
+from analysis import dashboard as d
+
+
+@pytest.fixture
+def ai_survey() -> pd.DataFrame:
+    return pd.DataFrame({
+        "Country": ["France", "France", "France", "France", "Germany", "Germany", "Japan"],
+        "AISelect": [d.NO_AI, d.NO_AI, "General-purpose AI chat tools",
+                     None, d.NO_AI, "General-purpose AI chat tools", d.NO_AI],
+        "AIAvoid": [f"{d.ENVIRONMENT};Moral or ethical concerns", d.ENVIRONMENT, d.NO_RESERVE,
+                    None, d.NO_RESERVE, d.ENVIRONMENT, d.ENVIRONMENT],
+        "AITrust": [None, None, d.TRUST_VERIFY, None, None, d.TRUST_VERIFY, None],
+    })
+
+
+def test_add_zone_keeps_only_france_and_comparison(ai_survey):
+    z = d.add_zone(ai_survey, ["Germany"])
+    assert "Japan" not in set(z["Country"])
+    assert (z.loc[z["Country"] == "France", d.ZONE] == d.FRANCE).all()
+    assert (z.loc[z["Country"] == "Germany", d.ZONE] == d.EUROPE).all()
+
+
+def test_share_answer_base_is_respondents_to_question(ai_survey):
+    fr = ai_survey[ai_survey["Country"] == "France"]
+    s = d.share_answer(fr, "AISelect", d.NO_AI)
+    assert s == {"share": pytest.approx(2 / 3), "n": 2, "base": 3}
+
+
+def test_zone_kpis_compare_france_and_europe(ai_survey):
+    k = d.zone_kpis(d.add_zone(ai_survey, ["Germany"])).set_index("key")
+    assert k.loc["no_ai", "share_fr"] == pytest.approx(2 / 3)
+    assert k.loc["no_ai", "share_eu"] == pytest.approx(1 / 2)
+    assert k.loc["environment", "base_fr"] == 3
+    assert k.loc["no_ai", "gap_pts"] == pytest.approx(100 * (2 / 3 - 1 / 2))
+
+
+def test_zone_kpis_survive_missing_europe(ai_survey):
+    k = d.zone_kpis(d.add_zone(ai_survey, [])).set_index("key")
+    assert k.loc["no_ai", "share_eu"] is None and k.loc["no_ai", "gap_pts"] is None
+
+
+def test_no_ai_by_country_uses_french_labels(ai_survey):
+    t = d.no_ai_by_country(d.add_zone(ai_survey, ["Germany"])).set_index("option")
+    assert set(t.index) == {"France", "Allemagne"}
+    assert t.loc["Allemagne", "share"] == pytest.approx(0.5)
+
+
+def test_barriers_by_zone_translates_and_aligns(ai_survey):
+    b = d.barriers_by_zone(d.add_zone(ai_survey, ["Germany"])).set_index("option")
+    env = b.loc["Préoccupations environnementales"]
+    assert env["share_fr"] == pytest.approx(2 / 3) and env["share_eu"] == pytest.approx(1 / 2)
+    # Option absente en Europe : part nulle, base conservée.
+    ethics = b.loc["Raisons morales ou éthiques"]
+    assert ethics["share_eu"] == 0 and ethics["base_eu"] == 2
